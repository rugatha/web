{
  "name": "rugatha-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "images:audit": "node scripts/image-assets.mjs audit",
    "images:status": "node scripts/image-storage-status.mjs",
    "images:prepare": "node scripts/image-assets.mjs prepare docs/image-migration/inventory.json",
    "images:publish": "node scripts/publish-image-assets.mjs",
    "images:switch": "node scripts/switch-image-assets.mjs",
    "images:originals": "node scripts/image-original-archive.mjs",
    "images:retire": "node scripts/retire-image-originals.mjs",
    "test:images": "node --test tests/image-assets.test.mjs tests/image-pwa.test.mjs tests/image-retirement.test.mjs",
    "test:image-browser": "playwright test --config playwright.images.config.mjs",
    "test:image-rules": "firebase emulators:exec --project demo-rugatha-images --only storage \"node --test tests/image-storage-rules.test.mjs\"",
    "test:rules": "firebase emulators:exec --project demo-rugatha --only firestore,storage \"node --test tests/firebase-rules.test.mjs\"",
    "test": "npm run test:rules && npm run test:images && npm run test:spellbooks && node --test tests/character-*.test.mjs toolbox/character_sheet/tests/*.test.mjs",
    "test:spellbooks": "node --test tests/spellbook*.test.mjs",
    "test:browser": "firebase emulators:exec --project demo-rugatha --only auth,firestore,storage \"playwright test\"",
    "test:all": "npm test && npm run test:browser && npm run test:image-rules && npm run test:image-browser",
    "test:browser:setup": "npm run test:catalog:setup && node scripts/prepare-spellbook-browser-tests.mjs && playwright install chromium",
    "catalog:publish": "node scripts/publish-spell-catalog.mjs",
    "test:catalog:setup": "node scripts/prepare-spell-catalog-tests.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.64.1",
    "firebase": "12.19.0",
    "firebase-tools": "15.31.0"
  }
}
