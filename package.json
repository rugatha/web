{
  "name": "rugatha-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test:migration": "python3 -m unittest tests/test_firestore_migration.py",
    "test:rules": "firebase emulators:exec --project demo-rugatha --only firestore,storage \"node --test tests/firebase-rules.test.mjs\"",
    "test:maintenance-rules": "firebase --config firebase.maintenance.json emulators:exec --project demo-rugatha-maintenance --only database \"node --test tests/database-maintenance-rules.test.mjs\"",
    "test": "npm run test:migration && npm run test:rules && npm run test:maintenance-rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.31.0"
  }
}
