{
  "name": "rugatha-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test:rules": "firebase emulators:exec --project demo-rugatha --only firestore,storage \"node --test tests/firebase-rules.test.mjs\"",
    "test": "npm run test:rules && npm run test:spellbooks && node --test tests/character-*.test.mjs toolbox/character_sheet/tests/*.test.mjs",
    "test:spellbooks": "node --test tests/spellbook*.test.mjs",
    "test:browser": "firebase emulators:exec --project demo-rugatha --only auth,firestore,storage \"playwright test\"",
    "test:all": "npm test && npm run test:browser",
    "test:browser:setup": "npm run test:catalog:setup && node scripts/prepare-spellbook-browser-tests.mjs && playwright install chromium",
    "catalog:publish": "node scripts/publish-spell-catalog.mjs",
    "test:catalog:setup": "node scripts/prepare-spell-catalog-tests.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.64.1",
    "firebase": "12.19.0",
    "firebase-tools": "15.31.0"
  }
}
