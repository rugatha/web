rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function validAvatar(fileName) {
      return fileName.matches('avatar\\.(webp|jpg|jpeg|png)')
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg|png)');
    }

    match /profile-photos/{uid}/{fileName} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if false;
      allow create, update: if isOwner(uid) && validAvatar(fileName);
      allow delete: if isOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
