assets/banner/campaign-pcs/

# OS files
.DS_Store

# Template pages
template/

# Dependencies and Python caches
node_modules/
.venv/
__pycache__/
*.pyc

# Firebase credentials, secrets, and local state
*.service-account.json
service-account*.json
.firebase/
/functions/.secret.local
/functions/.env*

# Firebase debug logs
firebase-debug.log
firestore-debug.log
database-debug.log
ui-debug.log
functions-debug.log

# Private Firebase migration inputs and reports
migration-private/
*rtdb-export*.json

# Browser acceptance artifacts
playwright-report/
test-results/

# Generated previews and preparation batches belong outside the source tree.
/output/
/docs/image-migration/prepared-*/
/docs/image-migration/storage-status.json

# Local working directories
/skills/
/species/
/lab/
/cicd/

# Experience subscription assets and private historical responses
/experience/subscribe/experience-notification.html
/experience/subscription.png
/experience/experience_his.csv
/experience/feedback_his.csv

# Campaign working pages (keep the listed pages tracked)
campaigns/pages/rugatha-plus/plus-c08/*
!campaigns/pages/rugatha-plus/plus-c08/chpt01.html
!campaigns/pages/rugatha-plus/plus-c08/chpt02.html
!campaigns/pages/rugatha-plus/plus-c08/chpt03.html
!campaigns/pages/rugatha-plus/plus-c08/temp.html
!campaigns/pages/rugatha-plus/plus-c08/index.html

# Full spell catalogs live in Firebase Storage; test caches must stay outside Git.
/toolbox/spells/spells-phb.json
/toolbox/race_class/class_spells.json

