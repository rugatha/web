{
  "firestore": {
    "database": "(default)",
    "location": "asia-east1",
    "rules": "config/firebase/firestore.rules",
    "indexes": "config/firebase/firestore.indexes.json"
  },
  "functions": [{
    "source": "functions",
    "codebase": "newsletter",
    "ignore": ["node_modules", ".git", "*.log", ".secret.local", ".env*"]
  }],
  "storage": {
    "rules": "config/firebase/storage.rules"
  },
  "emulators": {
    "functions": { "port": 5001 },
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
