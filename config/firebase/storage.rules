rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && (
          ('admin' in request.auth.token && request.auth.token.admin == true)
          || (
            'email' in request.auth.token
            && 'email_verified' in request.auth.token
            && request.auth.token.email_verified == true
            && request.auth.token.email == 'rugathadnd@gmail.com'
          )
        );
    }

    function validAvatar(fileName) {
      return fileName.matches('avatar\\.(webp|jpg|jpeg|png)')
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg|png)');
    }

    // Public reference data. Releases are uploaded with IAM-admin credentials;
    // even signed-in clients and app admins cannot modify or list these assets.
    match /catalogs/spells/{version}/{fileName} {
      allow get: if fileName in ['spells-phb.json', 'class_spells.json'];
      allow list, write: if false;
    }

    // Public editorial images only. Content-addressed variants are published
    // through IAM; no client (including app admins) may list or modify them.
    match /public-images/{category}/{assetId}/{hash}/{fileName} {
      allow get: if category in ['arcs', 'chapters', 'npcs']
        && assetId.matches('[a-z0-9_-]+')
        && hash.matches('[a-f0-9]{64}')
        && fileName in ['thumb.webp', 'reading.webp'];
      allow list, write: if false;
    }

    // Generated location artwork, preserved at its original PNG resolution.
    match /public-images/locations/{assetId}/{hash}/reading.png {
      allow get: if assetId.matches('[a-z0-9_-]+')
        && hash.matches('[a-f0-9]{64}');
      allow list, write: if false;
    }

    // NPC autographs retain transparent PNGs, published immutably through IAM.
    match /public-images/signatures/{assetId}/{hash}/signature.png {
      allow get: if assetId.matches('[a-z0-9_-]+')
        && hash.matches('[a-f0-9]{64}');
      allow list, write: if false;
    }

    match /profile-photos/{uid}/{fileName} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if false;
      allow create, update: if isOwner(uid) && validAvatar(fileName);
      allow delete: if isOwner(uid);
    }

    match /character-portraits/{uid}/{characterKey}/{fileName} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if false;
      allow create, update: if isOwner(uid)
        && fileName.matches('portrait(-[0-9]+)?\\.(webp|jpg|jpeg|png)')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg|png)');
      allow delete: if isOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
