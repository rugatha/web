rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && (
          ('admin' in request.auth.token && request.auth.token.admin == true)
          || (
            'email' in request.auth.token
            && 'email_verified' in request.auth.token
            && request.auth.token.email_verified == true
            && request.auth.token.email == 'rugathadnd@gmail.com'
          )
        );
    }

    // Dedicated password-authenticated account, never an administrator.
    function canManageD3() {
      return isAdmin() || (signedIn() && request.auth.uid == 'd3-helper-2026');
    }

    function memberPath(uid) {
      return /databases/$(database)/documents/members/$(memberKey(uid));
    }

    function memberKey(uid) {
      return exists(/databases/$(database)/documents/memberKeys/$(uid))
        ? get(/databases/$(database)/documents/memberKeys/$(uid)).data.memberNo : uid;
    }

    function newMemberPath(uid) {
      let key = getAfter(/databases/$(database)/documents/memberKeys/$(uid)).data.memberNo;
      return /databases/$(database)/documents/members/$(key);
    }

    function counterPath() {
      return /databases/$(database)/documents/system/memberNumbers;
    }

    function qaStatsPath(pageKey) {
      return /databases/$(database)/documents/qaStats/$(pageKey);
    }

    function qaChoicePath(uid, pageKey) {
      return /databases/$(database)/documents/members/$(memberKey(uid))/qaChoices/$(pageKey);
    }

    function validProfile(profile, uid) {
      return profile is map
        && profile.keys().hasOnly([
          'title', 'religion', 'species', 'className', 'kingdom', 'photo'
        ])
        && (!('title' in profile) || (profile.title is string && profile.title.size() <= 80))
        && (!('religion' in profile) || (profile.religion is string && profile.religion.size() <= 120))
        && (!('species' in profile) || (profile.species is string && profile.species.size() <= 80))
        && (!('className' in profile) || (profile.className is string && profile.className.size() <= 80))
        && (!('kingdom' in profile) || (profile.kingdom is string && profile.kingdom.size() <= 120))
        && (!('photo' in profile) || profile.photo == null || (
          profile.photo is map
          && profile.photo.keys().hasOnly(['path', 'contentType', 'size', 'updatedAt'])
          && profile.photo.path is string
          && profile.photo.path.matches('profile-photos/' + uid + '/avatar\\.(webp|jpg|jpeg|png)')
          && profile.photo.contentType is string
          && profile.photo.contentType.matches('image/(webp|jpeg|png)')
          && profile.photo.size is int
          && profile.photo.size > 0
          && profile.photo.size <= 2 * 1024 * 1024
          && profile.photo.updatedAt is timestamp
        ));
    }

    function validBadges(badges) {
      return badges is map
        && badges.keys().hasOnly(['STR', 'DEX', 'CON', 'INT', 'WIS', 'CHA'])
        && (!('STR' in badges) || (badges.STR is int && badges.STR >= 0 && badges.STR <= 20))
        && (!('DEX' in badges) || (badges.DEX is int && badges.DEX >= 0 && badges.DEX <= 20))
        && (!('CON' in badges) || (badges.CON is int && badges.CON >= 0 && badges.CON <= 20))
        && (!('INT' in badges) || (badges.INT is int && badges.INT >= 0 && badges.INT <= 20))
        && (!('WIS' in badges) || (badges.WIS is int && badges.WIS >= 0 && badges.WIS <= 20))
        && (!('CHA' in badges) || (badges.CHA is int && badges.CHA >= 0 && badges.CHA <= 20));
    }

    function counterAdvancesTo(number) {
      return exists(counterPath())
        && get(counterPath()).data.lastAllocated is int
        && getAfter(counterPath()).data.lastAllocated == number
        && number == get(counterPath()).data.lastAllocated + 1;
    }

    function validMemberCreate(uid) {
      return request.resource.data.keys().hasOnly([
          'schemaVersion', 'memberId', 'memberNo', 'memberNoNumber', 'displayName', 'email',
          'profile', 'badges', 'achievements', 'rewardedAchievements',
          'qaChoiceCount', 'totalTimeSeconds', 'campaign', 'character',
          'createdAt', 'lastLoginAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'schemaVersion', 'memberId', 'memberNo', 'memberNoNumber', 'displayName', 'email',
          'profile', 'badges', 'achievements', 'rewardedAchievements',
          'qaChoiceCount', 'totalTimeSeconds', 'campaign', 'character',
          'createdAt', 'lastLoginAt', 'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.memberId == uid
        && request.resource.data.memberNo is string
        && request.resource.data.memberNo.matches('[0-9]{4}-[0-9]{4}')
        && request.resource.data.memberNoNumber is int
        && request.resource.data.memberNoNumber == int(request.resource.data.memberNo.replace('-', ''))
        && request.resource.data.memberNoNumber > 0
        && counterAdvancesTo(request.resource.data.memberNoNumber)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && validProfile(request.resource.data.profile, uid)
        && validBadges(request.resource.data.badges)
        && request.resource.data.achievements is map
        && request.resource.data.rewardedAchievements is map
        && request.resource.data.qaChoiceCount == 0
        && request.resource.data.totalTimeSeconds == 0
        && request.resource.data.campaign is string
        && request.resource.data.character is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validMemberUpdate(uid) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'profile', 'badges', 'achievements',
          'rewardedAchievements', 'qaChoiceCount', 'totalTimeSeconds',
          'campaign', 'character', 'lastLoginAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && validProfile(request.resource.data.profile, uid)
        && validBadges(request.resource.data.badges)
        && request.resource.data.achievements is map
        && request.resource.data.rewardedAchievements is map
        && request.resource.data.qaChoiceCount is int
        && request.resource.data.qaChoiceCount >= 0
        && request.resource.data.totalTimeSeconds is int
        && request.resource.data.totalTimeSeconds >= 0
        && request.resource.data.campaign is string
        && request.resource.data.character is string
        && (request.resource.data.lastLoginAt == null
          || request.resource.data.lastLoginAt is timestamp)
        && request.resource.data.updatedAt == request.time;
    }

    // Version 1 IDs are the PHB English names. Update alongside the JSON catalog.
    function validSpellbook() {
      let data = request.resource.data;
      return data.keys().hasOnly(['schemaVersion', 'spellIds', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['schemaVersion', 'spellIds', 'createdAt', 'updatedAt'])
        && data.schemaVersion is int
        && data.schemaVersion == 1
        && data.spellIds is list
        && data.spellIds.size() <= 500
        && data.spellIds.toSet().size() == data.spellIds.size()
        && data.spellIds.toSet().hasOnly([
          "Acid Splash",
          "Aid",
          "Alarm",
          "Alter Self",
          "Animal Friendship",
          "Animal Messenger",
          "Animal Shapes",
          "Animate Dead",
          "Animate Objects",
          "Antilife Shell",
          "Antimagic Field",
          "Antipathy/Sympathy",
          "Arcane Eye",
          "Arcane Gate",
          "Arcane Lock",
          "Armor of Agathys",
          "Arms of Hadar",
          "Astral Projection",
          "Augury",
          "Aura of Life",
          "Aura of Purity",
          "Aura of Vitality",
          "Awaken",
          "Bane",
          "Banishing Smite",
          "Banishment",
          "Barkskin",
          "Beacon of Hope",
          "Beast Sense",
          "Bestow Curse",
          "Bigby's Hand",
          "Blade Barrier",
          "Blade Ward",
          "Bless",
          "Blight",
          "Blinding Smite",
          "Blindness/Deafness",
          "Blink",
          "Blur",
          "Branding Smite",
          "Burning Hands",
          "Call Lightning",
          "Calm Emotions",
          "Chain Lightning",
          "Charm Person",
          "Chill Touch",
          "Chromatic Orb",
          "Circle of Death",
          "Circle of Power",
          "Clairvoyance",
          "Clone",
          "Cloud of Daggers",
          "Cloudkill",
          "Color Spray",
          "Command",
          "Commune",
          "Commune with Nature",
          "Compelled Duel",
          "Comprehend Languages",
          "Compulsion",
          "Cone of Cold",
          "Confusion",
          "Conjure Animals",
          "Conjure Barrage",
          "Conjure Celestial",
          "Conjure Elemental",
          "Conjure Fey",
          "Conjure Minor Elementals",
          "Conjure Volley",
          "Conjure Woodland Beings",
          "Contact Other Plane",
          "Contagion",
          "Contingency",
          "Continual Flame",
          "Control Water",
          "Control Weather",
          "Cordon of Arrows",
          "Counterspell",
          "Create Food and Water",
          "Create or Destroy Water",
          "Create Undead",
          "Creation",
          "Crown of Madness",
          "Crusader's Mantle",
          "Cure Wounds",
          "Dancing Lights",
          "Darkness",
          "Darkvision",
          "Daylight",
          "Death Ward",
          "Delayed Blast Fireball",
          "Demiplane",
          "Destructive Wave",
          "Detect Evil and Good",
          "Detect Magic",
          "Detect Poison and Disease",
          "Detect Thoughts",
          "Dimension Door",
          "Disguise Self",
          "Disintegrate",
          "Dispel Evil and Good",
          "Dispel Magic",
          "Dissonant Whispers",
          "Divination",
          "Divine Favor",
          "Divine Word",
          "Dominate Beast",
          "Dominate Monster",
          "Dominate Person",
          "Drawmij's Instant Summons",
          "Dream",
          "Druidcraft",
          "Earthquake",
          "Eldritch Blast",
          "Elemental Weapon",
          "Enhance Ability",
          "Enlarge/Reduce",
          "Ensnaring Strike",
          "Entangle",
          "Enthrall",
          "Etherealness",
          "Evard's Black Tentacles",
          "Expeditious Retreat",
          "Eyebite",
          "Fabricate",
          "Faerie Fire",
          "False Life",
          "Fear",
          "Feather Fall",
          "Feeblemind",
          "Feign Death",
          "Find Familiar",
          "Find Steed",
          "Find the Path",
          "Find Traps",
          "Finger of Death",
          "Fire Bolt",
          "Fire Shield",
          "Fire Storm",
          "Fireball",
          "Flame Blade",
          "Flame Strike",
          "Flaming Sphere",
          "Flesh to Stone",
          "Fly",
          "Fog Cloud",
          "Forbiddance",
          "Forcecage",
          "Foresight",
          "Freedom of Movement",
          "Friends",
          "Gaseous Form",
          "Gate",
          "Geas",
          "Gentle Repose",
          "Giant Insect",
          "Glibness",
          "Globe of Invulnerability",
          "Glyph of Warding",
          "Goodberry",
          "Grasping Vine",
          "Grease",
          "Greater Invisibility",
          "Greater Restoration",
          "Guardian of Faith",
          "Guards and Wards",
          "Guidance",
          "Guiding Bolt",
          "Gust of Wind",
          "Hail of Thorns",
          "Hallow",
          "Hallucinatory Terrain",
          "Harm",
          "Haste",
          "Heal",
          "Healing Word",
          "Heat Metal",
          "Hellish Rebuke",
          "Heroes' Feast",
          "Heroism",
          "Hex",
          "Hold Monster",
          "Hold Person",
          "Holy Aura",
          "Hunger of Hadar",
          "Hunter's Mark",
          "Hypnotic Pattern",
          "Ice Storm",
          "Identify",
          "Illusory Script",
          "Imprisonment",
          "Incendiary Cloud",
          "Inflict Wounds",
          "Insect Plague",
          "Invisibility",
          "Jump",
          "Knock",
          "Legend Lore",
          "Leomund's Secret Chest",
          "Leomund's Tiny Hut",
          "Lesser Restoration",
          "Levitate",
          "Light",
          "Lightning Arrow",
          "Lightning Bolt",
          "Locate Animals or Plants",
          "Locate Creature",
          "Locate Object",
          "Longstrider",
          "Mage Armor",
          "Mage Hand",
          "Magic Circle",
          "Magic Jar",
          "Magic Missile",
          "Magic Mouth",
          "Magic Weapon",
          "Major Image",
          "Mass Cure Wounds",
          "Mass Heal",
          "Mass Healing Word",
          "Mass Suggestion",
          "Maze",
          "Meld into Stone",
          "Melf's Acid Arrow",
          "Mending",
          "Message",
          "Meteor Swarm",
          "Mind Blank",
          "Minor Illusion",
          "Mirage Arcane",
          "Mirror Image",
          "Mislead",
          "Misty Step",
          "Modify Memory",
          "Moonbeam",
          "Mordenkainen's Faithful Hound",
          "Mordenkainen's Magnificent Mansion",
          "Mordenkainen's Private Sanctum",
          "Mordenkainen's Sword",
          "Move Earth",
          "Nondetection",
          "Nystul's Magic Aura",
          "Otiluke's Freezing Sphere",
          "Otiluke's Resilient Sphere",
          "Otto's Irresistible Dance",
          "Pass without Trace",
          "Passwall",
          "Phantasmal Force",
          "Phantasmal Killer",
          "Phantom Steed",
          "Planar Ally",
          "Planar Binding",
          "Plane Shift",
          "Plant Growth",
          "Poison Spray",
          "Polymorph",
          "Power Word Heal",
          "Power Word Kill",
          "Power Word Stun",
          "Prayer of Healing",
          "Prestidigitation",
          "Prismatic Spray",
          "Prismatic Wall",
          "Produce Flame",
          "Programmed Illusion",
          "Project Image",
          "Protection from Energy",
          "Protection from Evil and Good",
          "Protection from Poison",
          "Purify Food and Drink",
          "Raise Dead",
          "Rary's Telepathic Bond",
          "Ray of Enfeeblement",
          "Ray of Frost",
          "Ray of Sickness",
          "Regenerate",
          "Reincarnate",
          "Remove Curse",
          "Resistance",
          "Resurrection",
          "Reverse Gravity",
          "Revivify",
          "Rope Trick",
          "Sacred Flame",
          "Sanctuary",
          "Scorching Ray",
          "Scrying",
          "Searing Smite",
          "See Invisibility",
          "Seeming",
          "Sending",
          "Sequester",
          "Shapechange",
          "Shatter",
          "Shield",
          "Shield of Faith",
          "Shillelagh",
          "Shocking Grasp",
          "Silence",
          "Silent Image",
          "Simulacrum",
          "Sleep",
          "Sleet Storm",
          "Slow",
          "Spare the Dying",
          "Speak with Animals",
          "Speak with Dead",
          "Speak with Plants",
          "Spider Climb",
          "Spike Growth",
          "Spirit Guardians",
          "Spiritual Weapon",
          "Staggering Smite",
          "Stinking Cloud",
          "Stone Shape",
          "Stoneskin",
          "Storm of Vengeance",
          "Suggestion",
          "Sunbeam",
          "Sunburst",
          "Swift Quiver",
          "Symbol",
          "Tasha's Hideous Laughter",
          "Telekinesis",
          "Telepathy",
          "Teleport",
          "Teleportation Circle",
          "Tenser's Floating Disk",
          "Thaumaturgy",
          "Thorn Whip",
          "Thunderous Smite",
          "Thunderwave",
          "Time Stop",
          "Tongues",
          "Transport via Plants",
          "Tree Stride",
          "True Polymorph",
          "True Resurrection",
          "True Seeing",
          "True Strike",
          "Tsunami",
          "Unseen Servant",
          "Vampiric Touch",
          "Vicious Mockery",
          "Wall of Fire",
          "Wall of Force",
          "Wall of Ice",
          "Wall of Stone",
          "Wall of Thorns",
          "Warding Bond",
          "Water Breathing",
          "Water Walk",
          "Web",
          "Weird",
          "Wind Walk",
          "Wind Wall",
          "Wish",
          "Witch Bolt",
          "Word of Recall",
          "Wrathful Smite",
          "Zone of Truth"
        ])
        && data.updatedAt == request.time;
    }

    function validBookmark() {
      return request.resource.data.keys().hasOnly(['path', 'title', 'savedAt'])
        && request.resource.data.keys().hasAll(['path', 'title', 'savedAt'])
        && request.resource.data.path is string
        && request.resource.data.path.size() > 0
        && request.resource.data.path.size() <= 1500
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 300
        && request.resource.data.savedAt is timestamp;
    }

    function validCharacterPortrait(portrait, uid) {
      return portrait == null || (
        portrait is map
        && portrait.keys().hasOnly(['path', 'contentType', 'size', 'updatedAt'])
        && portrait.keys().hasAll(['path', 'contentType', 'size', 'updatedAt'])
        && portrait.path is string
        && portrait.path.matches(
          'character-portraits/' + uid + '/[^/]+/portrait(-[0-9]+)?\\.(webp|jpg|jpeg|png)'
        )
        && portrait.contentType is string
        && portrait.contentType.matches('image/(webp|jpeg|png)')
        && portrait.size is int
        && portrait.size > 0
        && portrait.size <= 5 * 1024 * 1024
        && portrait.updatedAt is timestamp
      );
    }

    function validCharacterSheet(uid) {
      return request.resource.data.keys().hasOnly([
          'schemaVersion', 'memberId', 'characterName', 'className', 'race',
          'data', 'portrait', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'schemaVersion', 'memberId', 'characterName', 'className', 'race',
          'data', 'portrait', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.schemaVersion in [1, 2]
        && request.resource.data.memberId == uid
        && request.resource.data.characterName is string
        && request.resource.data.characterName.size() > 0
        && request.resource.data.characterName.size() <= 120
        && request.resource.data.className is string
        && request.resource.data.className.size() <= 120
        && request.resource.data.race is string
        && request.resource.data.race.size() <= 120
        && request.resource.data.data is map
        && validCharacterPortrait(request.resource.data.portrait, uid)
        && request.resource.data.updatedAt == request.time;
    }

    function validChoiceData(data) {
      return data.keys().hasOnly(['questionPage', 'choice', 'createdAt'])
        && data.keys().hasAll(['questionPage', 'choice', 'createdAt'])
        && data.questionPage is string
        && data.questionPage.size() > 0
        && data.questionPage.size() <= 1500
        && (data.choice == 'C1' || data.choice == 'C2')
        && data.createdAt is timestamp;
    }

    function validExistingStatsIncrement(pageKey, uid, choice) {
      let before = get(qaStatsPath(pageKey)).data;
      let after = getAfter(qaStatsPath(pageKey)).data;
      return after.keys().hasOnly(['questionPage', 'c1', 'c2', 'total', 'updatedAt'])
        && after.questionPage == before.questionPage
        && after.questionPage == getAfter(qaChoicePath(uid, pageKey)).data.questionPage
        && after.c1 == before.c1 + (choice == 'C1' ? 1 : 0)
        && after.c2 == before.c2 + (choice == 'C2' ? 1 : 0)
        && after.total == before.total + 1
        && after.total == after.c1 + after.c2
        && after.updatedAt == request.time;
    }

    function validNewStats(pageKey, uid, choice) {
      let after = getAfter(qaStatsPath(pageKey)).data;
      return after.keys().hasOnly(['questionPage', 'c1', 'c2', 'total', 'updatedAt'])
        && after.questionPage == getAfter(qaChoicePath(uid, pageKey)).data.questionPage
        && after.c1 == (choice == 'C1' ? 1 : 0)
        && after.c2 == (choice == 'C2' ? 1 : 0)
        && after.total == 1
        && after.updatedAt == request.time;
    }

    function validStatsWrite(pageKey, uid, choice) {
      return exists(qaStatsPath(pageKey))
        ? validExistingStatsIncrement(pageKey, uid, choice)
        : validNewStats(pageKey, uid, choice);
    }

    match /memberKeys/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['memberNo'])
        && request.resource.data.memberNo.matches('[0-9]{4}-[0-9]{4}')
        && !exists(/databases/$(database)/documents/members/$(request.resource.data.memberNo))
        && getAfter(newMemberPath(uid)).data.memberId == uid
        && getAfter(newMemberPath(uid)).data.memberNo == request.resource.data.memberNo
        && counterAdvancesTo(getAfter(newMemberPath(uid)).data.memberNoNumber);
      allow update, delete: if false;
    }

    match /members/{key} {
      function ownsMember() {
        return signedIn() && memberKey(request.auth.uid) == key;
      }
      // First registration probes the legacy UID path and the next allocated
      // number. Do not allow probing every other member number by status code.
      allow get: if ownsMember() || isAdmin()
        || (signedIn() && key == request.auth.uid
          && !exists(/databases/$(database)/documents/members/$(key)))
        || (signedIn() && key.matches('[0-9]{4}-[0-9]{4}')
          && int(key.replace('-', '')) == get(counterPath()).data.lastAllocated + 1
          && !exists(/databases/$(database)/documents/members/$(key)));
      allow list: if isAdmin();
      allow create: if signedIn() && key == request.resource.data.memberNo
        && getAfter(/databases/$(database)/documents/memberKeys/$(request.auth.uid)).data.memberNo == key
        && validMemberCreate(request.auth.uid);
      allow update: if ownsMember() && validMemberUpdate(request.auth.uid);
      allow delete: if false;

      match /spellbooks/{bookId} {
        allow get: if ownsMember() && bookId == 'default';
        allow list: if false;
        allow create: if ownsMember() && bookId == 'default'
          && validSpellbook() && request.resource.data.createdAt == request.time;
        allow update: if ownsMember() && bookId == 'default'
          && validSpellbook() && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /bookmarks/{pageKey} {
        allow read: if ownsMember() || isAdmin();
        allow create, update: if ownsMember() && validBookmark();
        allow delete: if ownsMember();
      }

      match /qaChoices/{pageKey} {
        allow read: if ownsMember() || isAdmin();
        allow create: if ownsMember()
          && validChoiceData(request.resource.data)
          && validStatsWrite(pageKey, request.auth.uid, request.resource.data.choice);
        allow update, delete: if false;
      }

      match /characters/{characterKey} {
        function parentPath() {
          return /databases/$(database)/documents/members/$(key)/characters/$(characterKey);
        }
        function bookPath() {
          return /databases/$(database)/documents/members/$(key)/characters/$(characterKey)/spellbooks/default;
        }
        allow read: if ownsMember() || isAdmin();
        allow create: if ownsMember()
          && validCharacterSheet(request.auth.uid)
          && request.resource.data.schemaVersion == 2
          && request.resource.data.createdAt == request.time;
        allow update: if ownsMember()
          && validCharacterSheet(request.auth.uid)
          && request.resource.data.schemaVersion >= resource.data.schemaVersion
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if ownsMember() && !existsAfter(bookPath());

        match /spellbooks/{bookId} {
          function upgradedParent() {
            return exists(parentPath()) && existsAfter(parentPath())
              && getAfter(parentPath()).data.schemaVersion == 2;
          }
          allow get: if bookId == 'default' && (ownsMember() || isAdmin()) && exists(parentPath());
          allow list: if false;
          allow create: if ownsMember() && bookId == 'default' && upgradedParent()
            && validSpellbook() && request.resource.data.createdAt == request.time;
          allow update: if ownsMember() && bookId == 'default' && upgradedParent()
            && validSpellbook() && request.resource.data.createdAt == resource.data.createdAt;
          allow delete: if ownsMember() && bookId == 'default' && !existsAfter(parentPath());
        }
      }
    }

    match /qaStats/{pageKey} {
      allow get: if true;
      allow list: if false;
      allow delete: if false;
      allow create, update: if signedIn()
        && !exists(qaChoicePath(request.auth.uid, pageKey))
        && validChoiceData(getAfter(qaChoicePath(request.auth.uid, pageKey)).data)
        && validStatsWrite(
          pageKey,
          request.auth.uid,
          getAfter(qaChoicePath(request.auth.uid, pageKey)).data.choice
        );
    }

    match /system/memberNumbers {
      allow get: if signedIn();
      allow list, create, delete: if false;
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['lastAllocated', 'updatedAt'])
        && request.resource.data.lastAllocated is int
        && request.resource.data.lastAllocated == resource.data.lastAllocated + 1
        && request.resource.data.updatedAt == request.time
        && (!exists(memberPath(request.auth.uid))
          || !('memberNoNumber' in get(memberPath(request.auth.uid)).data))
        && getAfter(newMemberPath(request.auth.uid)).data.memberNoNumber
          == request.resource.data.lastAllocated;
    }

    // Chapter credentials are admin-managed; clients never read password hashes.
    match /chapterAccess/{arc}/pages/{chapter} {
      function accessPath() {
        return /databases/$(database)/documents/chapterAccess/$(arc)/pages/$(chapter);
      }
      function grantPath() {
        return /databases/$(database)/documents/chapterAccess/$(arc)/pages/$(chapter)/grants/$(request.auth.uid);
      }
      function hasAccess() {
        return signedIn() && exists(grantPath())
          && get(grantPath()).data.passwordHash
            == get(accessPath()).data.passwordHashes[get(grantPath()).data.characterId];
      }
      function questionSettings(questionId) {
        return get(accessPath()).data.questions[questionId];
      }
      function publicChapter() {
        return 'lock' in get(accessPath()).data && get(accessPath()).data.lock == 0;
      }
      allow read, write: if isAdmin();

      match /grants/{uid} {
        allow get: if isOwner(uid) || isAdmin();
        allow list: if isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['characterId', 'passwordHash', 'verifiedAt'])
          && request.resource.data.keys().hasAll(['characterId', 'passwordHash', 'verifiedAt'])
          && request.resource.data.characterId in ['midori', 'samael', 'siri', 'yhwh', 'beau', 'ron']
          && request.resource.data.passwordHash is string
          && request.resource.data.passwordHash == get(accessPath()).data.passwordHashes[request.resource.data.characterId]
          && request.resource.data.verifiedAt == request.time;
        allow delete: if isOwner(uid) || isAdmin();
      }
      match /questions/{questionId}/answers/{characterId} {
        function canAnswer() {
          return hasAccess()
            && get(grantPath()).data.characterId == characterId
            && characterId in questionSettings(questionId).allowedCharacters;
        }
        function validAnswer() {
          let data = request.resource.data;
          return data.keys().hasOnly(['characterId', 'uid', 'option', 'customText', 'createdAt', 'updatedAt'])
            && data.keys().hasAll(['characterId', 'uid', 'option', 'customText', 'createdAt', 'updatedAt'])
            && data.characterId == characterId
            && data.uid == request.auth.uid
            && data.option is int && data.option >= 1 && data.option <= 5
            && data.customText is string && data.customText.size() <= 4000
            && ((data.option == 5 && data.customText.size() > 0) || (data.option != 5 && data.customText == ''))
            && data.updatedAt == request.time;
        }
        allow get: if isAdmin() || publicChapter()
          || (hasAccess() && get(grantPath()).data.characterId == characterId);
        allow list: if isAdmin() || publicChapter();
        allow create: if canAnswer() && validAnswer() && request.resource.data.createdAt == request.time;
        allow update: if canAnswer() && validAnswer() && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isAdmin();
      }
    }

    // Public registration intake; personal answers are only readable by admins.
    // D3 character creation: public seat counts, private contact details.
    match /d3Slots/{slotId} {
      function increment() {
        let a = request.resource.data;
        let path = /databases/$(database)/documents/d3Registrations/$(a.lastRegistrationId);
        let answer = getAfter(path).data;
        return resource.data.registrationOpen == true && request.time <= resource.data.deadline
          && a.diff(resource.data).affectedKeys().hasOnly(['registeredPlayers', 'lastRegistrationId', 'updatedAt'])
          && a.lastRegistrationId.matches('[a-zA-Z0-9]{20}')
          && !exists(path) && existsAfter(path) && answer.slotId == slotId
          && answer.partySize is int && answer.partySize in [1, 2]
          && resource.data.registeredPlayers >= 0
          && a.registeredPlayers == resource.data.registeredPlayers + answer.partySize
          && a.registeredPlayers <= 2 && a.updatedAt == request.time;
      }
      allow get: if true;
      function helperCancellation() {
        let before = resource.data;
        let after = request.resource.data;
        let path = /databases/$(database)/documents/d3Registrations/$(after.lastCancellationId);
        let booking = get(path).data;
        return canManageD3()
          && after.diff(before).affectedKeys().hasOnly(['registeredPlayers', 'lastCancellationId', 'updatedAt'])
          && booking.slotId == slotId
          && (!('status' in booking) || booking.status != 'cancelled')
          && getAfter(path).data.status == 'cancelled'
          && after.registeredPlayers == before.registeredPlayers - booking.partySize
          && after.registeredPlayers >= 0 && after.updatedAt == request.time;
      }
      allow list: if canManageD3();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || increment() || helperCancellation();
    }
    match /d3Registrations/{id} {
      function valid() {
        let d = request.resource.data;
        let path = /databases/$(database)/documents/d3Slots/$(d.slotId);
        let before = get(path).data;
        let after = getAfter(path).data;
        return id.matches('[a-zA-Z0-9]{20}')
          && d.keys().hasOnly(['slotId', 'name', 'phone', 'partySize', 'miniature', 'portrait', 'total', 'createdAt'])
          && d.slotId.matches('2026-12-(12|13)-(12|13|14|15|16|17)')
          && d.name is string && d.name.size() <= 80 && d.name.matches('.*[^\\s].*')
          && d.phone is string && d.phone.matches('[+0-9() \\-]{8,30}')
          && d.partySize is int && d.partySize in [1, 2]
          && d.miniature is bool && d.portrait is bool
          && d.total == (300 + (d.miniature ? 500 : 0) + (d.portrait ? 200 : 0)) * d.partySize
          && d.createdAt == request.time && before.registrationOpen == true && request.time <= before.deadline
          && after.lastRegistrationId == id && after.updatedAt == request.time
          && after.registeredPlayers == before.registeredPlayers + d.partySize && after.registeredPlayers <= 2;
      }
      allow create: if valid();
      allow read: if canManageD3();
      function cancelBooking() {
        let before = resource.data;
        let after = request.resource.data;
        let path = /databases/$(database)/documents/d3Slots/$(before.slotId);
        return canManageD3()
          && (!('status' in before) || before.status != 'cancelled')
          && after.diff(before).affectedKeys().hasOnly(['status', 'cancelledAt'])
          && after.status == 'cancelled' && after.cancelledAt == request.time
          && getAfter(path).data.registeredPlayers == get(path).data.registeredPlayers - before.partySize
          && getAfter(path).data.registeredPlayers >= 0
          && getAfter(path).data.updatedAt == request.time;
      }
      function editShipping() {
        let d = request.resource.data;
        return canManageD3()
          && d.diff(resource.data).affectedKeys().hasOnly(['recipientName', 'recipientPhone', 'recipientEmail', 'sevenElevenStore', 'shippingUpdatedAt'])
          && resource.data.miniature == true
          && d.recipientName is string && d.recipientName.size() <= 80 && d.recipientName.matches('.*[^\\s].*')
          && d.recipientPhone is string && d.recipientPhone.size() <= 30
          && (d.recipientPhone.matches('[+0-9() \\-]{8,30}'))
          && d.recipientEmail is string && d.recipientEmail.size() <= 254
          && (d.recipientEmail.matches('[^ @]+@[^ @]+[.][^ @]+'))
          && d.sevenElevenStore is string && d.sevenElevenStore.size() <= 120 && d.sevenElevenStore.matches('.*[^\\s].*')
          && d.shippingUpdatedAt == request.time;
      }
      function editAddons() {
        let d = request.resource.data;
        return canManageD3()
          && d.diff(resource.data).affectedKeys().hasOnly(['miniature', 'portrait', 'total', 'addonsUpdatedAt'])
          && d.miniature is bool && d.portrait is bool
          && d.partySize is int && d.partySize in [1, 2]
          && d.total == (300 + (d.miniature ? 500 : 0) + (d.portrait ? 200 : 0)) * d.partySize
          && d.addonsUpdatedAt == request.time;
      }
      function editImageEmail() {
        let d = request.resource.data;
        return canManageD3()
          && d.diff(resource.data).affectedKeys().hasOnly(['imageRecipientEmail', 'imageEmailUpdatedAt'])
          && d.imageRecipientEmail is string && d.imageRecipientEmail.size() <= 254
          && (d.imageRecipientEmail == '' || d.imageRecipientEmail.matches('[^ @]+@[^ @]+[.][^ @]+'))
          && d.imageEmailUpdatedAt == request.time;
      }
      allow update: if cancelBooking() || editShipping() || editAddons() || editImageEmail();
      allow delete: if false;
    }

    match /experienceEvents/{eventId} {
      function validSeatIncrement() {
        let before = resource.data;
        let after = request.resource.data;
        let registration = /databases/$(database)/documents/experienceRegistrations/$(after.lastRegistrationId);
        let answer = getAfter(registration).data;
        return before.registrationOpen == true && request.time <= before.deadline
          && after.diff(before).affectedKeys().hasOnly(['registeredPlayers', 'lastRegistrationId', 'updatedAt'])
          && after.lastRegistrationId.matches('[a-zA-Z0-9]{20}')
          && !exists(registration) && existsAfter(registration)
          && answer.eventId == eventId
          && answer.partySize is int && answer.partySize > 0
          && before.registeredPlayers is int && before.registeredPlayers >= 0
          && after.registeredPlayers is int
          && after.registeredPlayers == before.registeredPlayers + answer.partySize
          && after.registeredPlayers <= before.maxPlayers
          && after.updatedAt == request.time;
      }
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || validSeatIncrement();
    }

    match /experienceRegistrations/{registrationId} {
      function validText(value, maximum, required) {
        return value is string && value.size() <= maximum
          && (!required || value.matches('.*[^\\s].*'));
      }
      function validSelections(values, allowed) {
        return values is list && values.size() > 0
          && values.size() <= allowed.size()
          && values.toSet().size() == values.size()
          && values.hasOnly(allowed);
      }
      function validOther(values, text) {
        return validText(text, 150, values.hasAny(['其他']))
          && (values.hasAny(['其他']) || text == '');
      }
      function validRegistration() {
        let data = request.resource.data;
        let eventPath = /databases/$(database)/documents/experienceEvents/$(data.eventId);
        let event = get(eventPath).data;
        let after = getAfter(eventPath).data;
        return data.keys().hasOnly([
            'schemaVersion', 'eventId', 'name', 'contact', 'partySize',
            'systems', 'systemsOther', 'dndExperience', 'rugathaExperience',
            'sources', 'sourcesOther', 'boundaries', 'notes', 'createdAt'
          ])
          && data.keys().hasAll([
            'schemaVersion', 'eventId', 'name', 'contact', 'partySize',
            'systems', 'systemsOther', 'dndExperience', 'rugathaExperience',
            'sources', 'sourcesOther', 'boundaries', 'notes', 'createdAt'
          ])
          && data.schemaVersion == 1
          && data.eventId is string && data.eventId.size() <= 100
          && event.registrationOpen == true && request.time <= event.deadline
          && data.partySize is int && data.partySize >= 1
          && data.partySize <= event.maxPlayers
          && event.registeredPlayers is int && event.registeredPlayers >= 0
          && data.partySize <= event.maxPlayers - event.registeredPlayers
          && after.registeredPlayers == event.registeredPlayers + data.partySize
          && after.lastRegistrationId == registrationId
          && after.updatedAt == request.time
          && validText(data.name, 80, true) && validText(data.contact, 250, true)
          && validSelections(data.systems, ['龍與地下城 D&D', '克蘇魯的呼喚 CoC', '開拓者 Pathfinder', '其他', '無經驗'])
          && (!data.systems.hasAny(['無經驗']) || data.systems.size() == 1)
          && validOther(data.systems, data.systemsOther)
          && data.dndExperience in ['聽過，但沒玩過', '有玩過，但經驗較少', '過去或現在有固定團務', '有當過 DM']
          && data.rugathaExperience in ['有', '無']
          && validSelections(data.sources, ['親友推薦', '社群推薦（如其他粉絲專頁）', '臉書粉絲專頁', 'Instagram', 'Threads', 'Rugatha Discord 頻道', '臉書 TRPG/D&D 相關社團', 'TRPG 嘉年華會', '龍山地下城', '其他'])
          && validOther(data.sources, data.sourcesOther)
          && validText(data.boundaries, 2000, false) && validText(data.notes, 2000, false)
          && data.createdAt == request.time;
      }
      allow create: if registrationId.matches('[a-zA-Z0-9]{20}') && validRegistration();
      allow read: if isAdmin();
      function validCancellation() {
        let before = resource.data;
        let after = request.resource.data;
        let eventPath = /databases/$(database)/documents/experienceEvents/$(before.eventId);
        let event = get(eventPath).data;
        let updated = getAfter(eventPath).data;
        return isAdmin()
          && before.get('status', '') != 'cancelled'
          && after.diff(before).affectedKeys().hasOnly(['status', 'cancelledAt'])
          && after.status == 'cancelled' && after.cancelledAt == request.time
          && before.partySize is int && before.partySize > 0
          && updated.registeredPlayers == event.registeredPlayers - before.partySize
          && updated.registeredPlayers >= 0
          && updated.lastCancellationId == registrationId
          && updated.updatedAt == request.time;
      }
      function validAdminEdit() {
        let before = resource.data;
        let after = request.resource.data;
        let delta = (before.get('status', '') == 'cancelled' ? before.partySize : 0)
          - (after.status == 'cancelled' ? before.partySize : 0);
        let eventPath = /databases/$(database)/documents/experienceEvents/$(before.eventId);
        return isAdmin()
          && after.diff(before).affectedKeys().hasOnly(['status', 'DM_Note', 'updatedAt', 'cancelledAt'])
          && validText(after.status, 120, true)
          && validText(after.DM_Note, 10000, false)
          && after.updatedAt == request.time
          && ((delta == 0 && after.get('cancelledAt', null) == before.get('cancelledAt', null))
            || (delta != 0 && before.partySize is int && before.partySize > 0
              && getAfter(eventPath).data.registeredPlayers == get(eventPath).data.registeredPlayers + delta
              && getAfter(eventPath).data.registeredPlayers >= 0
              && getAfter(eventPath).data.registeredPlayers <= get(eventPath).data.maxPlayers
              && getAfter(eventPath).data.updatedAt == request.time
              && ((after.status == 'cancelled' && after.cancelledAt == request.time)
                || (after.status != 'cancelled' && after.cancelledAt == null))));
      }
      allow update: if validCancellation() || validAdminEdit();
      allow delete: if false;
    }


    match /experienceFeedback/{feedbackId} {
      function validText(value, maximum, required) {
        return value is string && value.size() <= maximum
          && (!required || value.matches('.*[^\\s].*'));
      }
      function validRating(value) {
        return value is int && value >= 1 && value <= 5;
      }
      function validFeedback() {
        let data = request.resource.data;
        let fields = ['schemaVersion', 'source', 'nickname', 'gender', 'genderOther',
          'ageRange', 'sessionDate', 'scenario', 'previousParticipation', 'interests',
          'storyRating', 'characterRating', 'dmRating', 'cardRating', 'propRating',
          'feeOpinion', 'privateFeedback', 'publicFeedback', 'createdAt'];
        return data.keys().hasOnly(fields.concat(['interestsOther'])) && data.keys().hasAll(fields)
          && data.schemaVersion == 1 && data.source == 'website'
          && validText(data.nickname, 80, true)
          && data.gender in ['男性', '女性', '其他/不願透露']
          && validText(data.genderOther, 150, false)
          && (data.gender == '其他/不願透露' || data.genderOther == '')
          && data.ageRange in ['12歲以下', '13-18', '18-22', '22-35', '36-45', '46-55', '56-65', '66歲以上', '不願透露']
          && data.sessionDate is string && data.sessionDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && data.scenario in ['體驗團《金之堡的卷軸》', '體驗團《龍鳴的回音》', 'TRPG Fes. 《寂靜與秩序之下》',
            '竹推《洛林精神：那些不被提及的歷史》', '體驗團《洛林精神：那些不被提及的歷史》']
          && data.previousParticipation in ['有', '無']
          && data.interests is list && data.interests.size() > 0 && data.interests.size() <= 5
          && data.interests.toSet().size() == data.interests.size()
          && data.interests.hasOnly(['TRPG遊戲', '劇本殺', '桌遊', 'RPG類電玩、手遊', '其他'])
          && (data.interests.hasAny(['其他'])
            ? ('interestsOther' in data && validText(data.interestsOther, 150, true))
            : (!('interestsOther' in data) || data.interestsOther == ''))
          && validRating(data.storyRating) && validRating(data.characterRating)
          && validRating(data.dmRating) && validRating(data.cardRating) && validRating(data.propRating)
          && data.feeOpinion in ['太便宜', '可以接受', '太貴']
          && validText(data.privateFeedback, 4000, false) && validText(data.publicFeedback, 4000, false)
          && data.createdAt == request.time;
      }
      allow create: if feedbackId.matches('[a-zA-Z0-9]{20}') && validFeedback();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /migrationRuns/{runId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
